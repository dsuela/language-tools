#!/usr/bin/env bash
# Generates editor/vscode/images/guide/tour.gif, the capability tour embedded
# in the Marketplace overview, from the guide screenshots. Requires ImageMagick.
set -euo pipefail

cd "$(dirname "$0")/../editor/vscode/images/guide"

FONT_BOLD="${FONT_BOLD:-/System/Library/Fonts/Supplemental/Arial Bold.ttf}"
FONT_REGULAR="${FONT_REGULAR:-/System/Library/Fonts/Supplemental/Arial.ttf}"

WIDTH=960
HEIGHT=600
BAND=72
BG="#1a1e26"
ACCENT="#8ab4f8"
DELAY=250 # per slide, in 1/100s

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# Every capture used by the visual catalog, in page order: editor workflows,
# then integrations, then the indexing lifecycle.
SLIDES=(
    "route-completion|Completion|Suggestions from effective runtime metadata and application source"
    "route-hover|Hover|Inspect framework metadata without leaving the call site"
    "definition|Definition and Document Links|Open declarations directly or peek at a target inline"
    "references|Find All References|Declarations and static usages across PHP, Twig and configuration"
    "rename|Rename|Update declarations and every statically recognized reference"
    "diagnostics|Diagnostics|High-confidence errors inline and in the Problems panel"
    "quick-fix|Quick Fixes|Safe edits for missing route parameters, templates and translations"
    "code-lenses|Code Lenses|Messenger, events, Twig components, Stimulus and Doctrine relationships"
    "dependency-injection|Dependency Injection|Effective services, aliases, autowiring types and parameters"
    "twig-templates|Twig Templates|Template names, render variables and component metadata"
    "twig-components|Twig Components|Component classes, public properties and Live Component metadata"
    "translations|Translations|Keys, domains, locales and placeholders across PHP and Twig"
    "environment|Environment Variables|Names and type-safe processor chains without revealing values"
    "configuration|Bundle Configuration|Keys, types, enum values, defaults and deprecations per environment"
    "messenger|Messenger|Buses, transports, routed messages, dispatch sites and effective handlers"
    "events|Events and Listeners|Dispatch sites, event classes, subscribers and listener priorities"
    "security|Security|Firewalls, providers, roles, hierarchy, authenticators and voters"
    "form-options|Forms|Form options from runtime and source metadata"
    "validation|Validation|Constraint options and mapped properties"
    "serializer|Serializer|Serializer groups from application metadata"
    "assets|AssetMapper and Importmaps|Logical asset paths resolved to application or vendor files"
    "stimulus|Stimulus|Controllers, actions, targets, values and outlets"
    "live-components|Live Components|Component properties, actions and events"
    "doctrine|Doctrine Entities and Repositories|Mapped fields, associations and form metadata relationships"
    "doctrine-code-lens|Doctrine Code Lenses|Navigate between entities and their repositories"
    "project-ready|Runtime Ready|The status item identifies the environment when both indexes are ready"
    "static-mode|Static-only Mode|Source-backed features without executing the application"
    "command-palette|Index Commands|Refresh, inspect status or switch environments from the Command Palette"
    "switch-environment|Environment Switching|Select another environment and rebuild its runtime metadata"
)

card() {
    local out="$1" line1="$2" line2="$3" line3="$4"
    magick -size "${WIDTH}x$((HEIGHT + BAND))" "xc:$BG" \
        -gravity center \
        -font "$FONT_BOLD" -pointsize 44 -fill white -annotate +0-40 "$line1" \
        -font "$FONT_REGULAR" -pointsize 24 -fill "$ACCENT" -annotate +0+20 "$line2" \
        -font "$FONT_REGULAR" -pointsize 18 -fill "#9aa3b2" -annotate +0+70 "$line3" \
        "$out"
}

card "$WORK/frame-00.png" "Symfony LSP for VS Code" \
    "A tour of every capability" \
    "Captured in the Symfony Demo application"

i=1
for slide in "${SLIDES[@]}"; do
    IFS='|' read -r image title text <<<"$slide"
    magick "$image.webp" -resize "${WIDTH}x${HEIGHT}" \
        -background "$BG" -gravity center -extent "${WIDTH}x${HEIGHT}" \
        \( -size "${WIDTH}x${BAND}" "xc:$BG" -gravity northwest \
            -font "$FONT_BOLD" -pointsize 21 -fill white -annotate +24+10 "$title" \
            -font "$FONT_REGULAR" -pointsize 16 -fill "#9aa3b2" -annotate +24+42 "$text" \) \
        -append "$(printf '%s/frame-%02d.png' "$WORK" "$i")"
    i=$((i + 1))
done

card "$(printf '%s/frame-%02d.png' "$WORK" "$i")" "Try it on your project" \
    "code --install-extension symfony.language-tools" \
    "github.com/symfony/language-tools"

magick -delay "$DELAY" "$WORK"/frame-*.png -loop 0 -layers optimize tour.gif

echo "Generated editor/vscode/images/guide/tour.gif"
