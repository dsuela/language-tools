#!/bin/sh
set -eu

NVIM=${1:-${NVIM:-nvim}}
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VERSION=$("$NVIM" --version | head -n 1 | tr ' /' '__')
STATE="$ROOT/var/neovim-tests/$VERSION"

rm -rf "$STATE"
mkdir -p "$STATE/config" "$STATE/data" "$STATE/state" "$STATE/cache"

run_test() {
    XDG_CONFIG_HOME="$STATE/config" \
    XDG_DATA_HOME="$STATE/data" \
    XDG_STATE_HOME="$STATE/state" \
    XDG_CACHE_HOME="$STATE/cache" \
        "$NVIM" --headless --clean -l "$ROOT/$1"
}

cd "$ROOT"
run_test editor/neovim/tests/unit.lua
run_test editor/neovim/tests/integration.lua

PACKAGE_REPOSITORY="$STATE/package-repository"
PACKAGE_ARCHIVE="$STATE/package.tar"
mkdir -p "$PACKAGE_REPOSITORY"
git archive --format=tar --output="$PACKAGE_ARCHIVE" HEAD
tar -xf "$PACKAGE_ARCHIVE" -C "$PACKAGE_REPOSITORY"
rm "$PACKAGE_ARCHIVE"
git -C "$PACKAGE_REPOSITORY" init --quiet --initial-branch=package-test
git -C "$PACKAGE_REPOSITORY" add .
git -C "$PACKAGE_REPOSITORY" \
    -c user.name='Symfony LSP Tests' \
    -c user.email='symfony-lsp-tests@localhost' \
    commit --quiet -m 'Create package test repository'
SYMFONY_LSP_PLUGIN_REVISION=$(git -C "$PACKAGE_REPOSITORY" rev-parse HEAD)
SYMFONY_LSP_PLUGIN_SOURCE="file://$PACKAGE_REPOSITORY"
export SYMFONY_LSP_PLUGIN_SOURCE SYMFONY_LSP_PLUGIN_REVISION
run_test editor/neovim/tests/package.lua
