#!/usr/bin/env php
<?php

// Diagnoses whether the amp stdio transport works on this platform's CLI PHP,
// independently of the micro runtime and the Tree-sitter extension.

use Fabpot\JsonRpc\ContentLengthJsonRpcTransport;

use function Amp\ByteStream\getStdin;
use function Amp\ByteStream\getStdout;

require __DIR__.'/../vendor/autoload.php';

if ('--serve' === ($argv[1] ?? null)) {
    $transport = new ContentLengthJsonRpcTransport(getStdin(), getStdout());
    $message = $transport->receive();
    $transport->send('{"jsonrpc":"2.0","id":1,"result":{"echo":'.json_encode($message).'}}');
    $transport->close();
    exit(0);
}

$outputPath = tempnam(sys_get_temp_dir(), 'amp-probe-out-');
$errorPath = tempnam(sys_get_temp_dir(), 'amp-probe-err-');
if (false === $outputPath || false === $errorPath) {
    throw new RuntimeException('Unable to create the probe output files.');
}
$process = proc_open(
    [\PHP_BINARY, __FILE__, '--serve'],
    [
        ['pipe', 'r'],
        ['file', $outputPath, 'w'],
        ['file', $errorPath, 'w'],
    ],
    $pipes,
    options: ['bypass_shell' => true],
);
if (!is_resource($process)) {
    throw new RuntimeException('Unable to start the probe server.');
}

$request = '{"jsonrpc":"2.0","id":1,"method":"ping"}';
fwrite($pipes[0], 'Content-Length: '.strlen($request)."\r\n\r\n".$request);
fflush($pipes[0]);

$deadline = microtime(true) + 20;
$response = '';
while (microtime(true) < $deadline) {
    $response = (string) file_get_contents($outputPath);
    if (str_contains($response, '"result"')) {
        fwrite(\STDOUT, "The amp stdio transport works on this platform.\n");
        proc_terminate($process);
        exit(0);
    }
    usleep(50000);
}

proc_terminate($process);
$error = (string) file_get_contents($errorPath);
fwrite(\STDOUT, "The amp stdio transport is broken on this platform.\n");
fwrite(\STDOUT, 'Probe server stdout: '.('' === $response ? '(empty)' : $response)."\n");
fwrite(\STDOUT, 'Probe server stderr: '.('' === $error ? '(empty)' : $error)."\n");
exit(1);
