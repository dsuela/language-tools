parameters:
    level: max
    paths:
        - bin
        - resources/services.php
        - src
        - tests
        - tools
    stubFiles:
        - stubs/tree_sitter.stub
    excludePaths:
        analyseAndScan:
            - tests/Fixtures/RuntimeApplication/*
            - tools/spc-inject-tree-sitter.php
            - tools/vscode-guide-scenarios/*
